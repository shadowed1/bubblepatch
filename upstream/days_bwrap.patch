+
+/* Return false only when the new mount API is unavailable.  Other errors
+ * must not be retried using a different mount API. */
+static bool
+mount_fs_fd (const char *fstype, int dest_fd, const char *dest_display,
+             unsigned int attrs, const FsMountOption *options, size_t n_options)
+{
+  cleanup_fd int fs_fd = -1;
+  cleanup_fd int mount_fd = -1;
+  size_t i;
+
+  fs_fd = fsopen_wrapper (fstype, FSOPEN_CLOEXEC);
+  if (fs_fd < 0)
+    {
+      if (errno == ENOSYS)
+        return false;
+      die_with_mount_error ("fsopen %s on %s", fstype, dest_display);
+    }
+
+  for (i = 0; i < n_options; i++)
+    if (fsconfig_wrapper (fs_fd, options[i].command, options[i].key,
+                          options[i].value, 0) != 0)
+      {
+        if (errno == ENOSYS)
+          return false;
+        die_with_mount_error ("fsconfig %s on %s", fstype, dest_display);
+      }
+
+  if (fsconfig_wrapper (fs_fd, FSCONFIG_CMD_CREATE, NULL, NULL, 0) != 0)
+    {
+      if (errno == ENOSYS)
+        return false;
+      die_with_mount_error ("fsconfig create %s on %s", fstype, dest_display);
+    }
+
+  mount_fd = fsmount_wrapper (fs_fd, FSMOUNT_CLOEXEC, attrs);
+  if (mount_fd < 0)
+    {
+      if (errno == ENOSYS)
+        return false;
+      die_with_mount_error ("fsmount %s on %s", fstype, dest_display);
+    }
+
+  if (move_mount_wrapper (mount_fd, "", dest_fd, "",
+                          MOVE_MOUNT_F_EMPTY_PATH |
+                          MOVE_MOUNT_T_EMPTY_PATH) != 0)
+    {
+      if (errno == ENOSYS)
+        return false;
+      die_with_mount_error ("move_mount %s on %s", fstype, dest_display);
+    }
+
+  return true;
+}
